server [label="API Server"]
db [label="PostgreSQL"]
cache [label="Redis"]
worker [label="Worker"]

server -> db
server -> cache
server -> worker
worker -> db
cache -.-> db</code></pre>
  </div>
  <div class="split-output">
    <div class="split-tabs">
